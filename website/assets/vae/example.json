{
  "id": "variational-autoencoder",
  "title": "A VAE in a few calls",
  "description": "Learn a nonlinear latent representation, reconstruct held-out images, and generate new ones. A focused Torch API handles the Bernoulli model and diagonal Normal encoder.",
  "steps": [
    {
      "id": "data",
      "title": "1. Generate the same synthetic training and test data",
      "smallprob": "import numpy as np\n\ndef synthetic_bars(n, seed):\n    \"\"\"Independent synthetic images: crossing bars with 1% random pixel flips.\"\"\"\n    rng = np.random.default_rng(seed)\n    images = np.zeros((n, 8, 8), dtype=np.float32)\n    rows, columns = rng.integers(1, 7, size=(2, n))\n    images[np.arange(n), rows, :] = 1\n    images[np.arange(n), :, columns] = 1\n    flips = rng.random(images.shape) < .01\n    return np.where(flips, 1 - images, images).reshape(n, 64)\n\ntrain = synthetic_bars(1024, seed=23)\ntest = synthetic_bars(256, seed=24)\n",
      "pyro": "import numpy as np\n\ndef synthetic_bars(n, seed):\n    \"\"\"Independent synthetic images: crossing bars with 1% random pixel flips.\"\"\"\n    rng = np.random.default_rng(seed)\n    images = np.zeros((n, 8, 8), dtype=np.float32)\n    rows, columns = rng.integers(1, 7, size=(2, n))\n    images[np.arange(n), rows, :] = 1\n    images[np.arange(n), :, columns] = 1\n    flips = rng.random(images.shape) < .01\n    return np.where(flips, 1 - images, images).reshape(n, 64)\n\ntrain = synthetic_bars(1024, seed=23)\ntest = synthetic_bars(256, seed=24)\n"
    },
    {
      "id": "model",
      "title": "2. Specify the model and inference family",
      "smallprob": "from smallprob.neural import VAE\n\nvae = VAE(input_dim=64, latent_dim=2, hidden_dim=128, seed=7)\n",
      "pyro": "import torch\nfrom torch import nn\nfrom torch.nn import functional as F\nimport pyro\nimport pyro.distributions as dist\n\ntorch.manual_seed(7)\n\nencoder = nn.Sequential(nn.Linear(64, 128), nn.SiLU(), nn.Linear(128, 4))\ndecoder = nn.Sequential(nn.Linear(2, 128), nn.SiLU(), nn.Linear(128, 64))\n\ndef model(x):\n    pyro.module(\"decoder\", decoder)\n    with pyro.plate(\"images\", len(x)):\n        z = pyro.sample(\"z\", dist.Normal(x.new_zeros(2), x.new_ones(2)).to_event(1))\n        pyro.sample(\"x\", dist.Bernoulli(logits=decoder(z)).to_event(1), obs=x)\n\ndef guide(x):\n    pyro.module(\"encoder\", encoder)\n    location, raw_scale = encoder(x).chunk(2, dim=-1)\n    scale = F.softplus(raw_scale) + 1e-4\n    with pyro.plate(\"images\", len(x)):\n        pyro.sample(\"z\", dist.Normal(location, scale).to_event(1))\n"
    },
    {
      "id": "fit",
      "title": "3. Fit with minibatches and evaluate held-out images",
      "smallprob": "history = vae.fit(\n    train, validation_data=test,\n    epochs=200, batch_size=128, learning_rate=0.003,\n    validation_particles=8, seed=11,\n)\nmetrics = vae.evaluate(test, particles=128, seed=21)\nprint(metrics)  # negative ELBO, reconstruction NLL, KL: nats per image\n",
      "pyro": "from pyro.infer import SVI, TraceMeanField_ELBO\nfrom pyro.optim import Adam\n\nx_train = torch.as_tensor(train, dtype=torch.float32)\nx_test = torch.as_tensor(test, dtype=torch.float32)\npyro.clear_param_store()\ntorch.manual_seed(11)\nsvi = SVI(model, guide, Adam({\"lr\": 0.003}), TraceMeanField_ELBO())\nfor epoch in range(200):\n    for indices in torch.randperm(len(x_train)).split(128):\n        svi.step(x_train[indices])\n\n# The loss sums over images; divide to get nats per image.\ntorch.manual_seed(21)\nevaluation = TraceMeanField_ELBO(num_particles=128)\ntest_negative_elbo = evaluation.loss(model, guide, x_test) / len(x_test)\n"
    },
    {
      "id": "reconstruct",
      "title": "4. Reconstruct images through the learned encoder",
      "smallprob": "reconstructed = vae.reconstruct(test[:12], particles=128, seed=29)\n",
      "pyro": "torch.manual_seed(29)\nwith torch.no_grad():\n    location, raw_scale = encoder(x_test[:12]).chunk(2, dim=-1)\n    scale = F.softplus(raw_scale) + 1e-4\n    z = dist.Normal(location, scale).sample((128,))\n    reconstructed = decoder(z).sigmoid().mean(0)\n"
    },
    {
      "id": "generate",
      "title": "5. Generate new images from the prior",
      "smallprob": "pixel_probabilities = vae.generate(12, probabilities=True, seed=31)\ngenerated = vae.generate(12, seed=31)  # actual binary samples\n",
      "pyro": "torch.manual_seed(31)\nwith torch.no_grad():\n    z = torch.randn(12, 2)\n    pixel_probabilities = decoder(z).sigmoid()\n    generated = dist.Bernoulli(pixel_probabilities).sample()\n"
    }
  ],
  "metrics": [
    {
      "label": "Held-out loss before training",
      "value": "45.01 nats",
      "detail": "Negative ELBO per image; lower is better."
    },
    {
      "label": "Smallprob after 200 epochs",
      "value": "15.04 nats",
      "detail": "128 posterior draws per image; exact Normal KL."
    },
    {
      "label": "Pyro after 200 epochs",
      "value": "15.03 nats",
      "detail": "An independent fit with the same data, architecture and analytic-KL ELBO."
    }
  ],
